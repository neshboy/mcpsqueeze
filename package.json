{
  "name": "mcpsqueeze",
  "version": "0.1.0",
  "description": "A drop-in proxy for MCP servers that deduplicates and truncates large/repeated tool-call results to save agent context tokens.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcpsqueeze": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "token-savings",
    "dedup",
    "llm",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
